# ============================================
# TELEGRAM BOT
# ============================================
# Токен получить у @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ============================================
# JWT
# ============================================
# Не короче 32 символов: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# ADMIN (создаётся при старте backend: python -m app.cli create-admin)
# ============================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ============================================
# DATABASE
# ============================================
# docker-compose собирает DATABASE_URL сам из этих переменных
POSTGRES_USER=itam
POSTGRES_PASSWORD=
POSTGRES_DB=itam_hack
# Локальный запуск без docker-compose (backend/.env или переменная окружения):
# DATABASE_URL=postgresql://itam:<пароль>@localhost:5432/itam_hack

# ============================================
# API
# ============================================
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost
CODE_EXPIRY_MINUTES=10
# CORS: список через запятую
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173
# Число доверенных прокси перед API (0 — прямое подключение, X-Forwarded-For игнорируется)
TRUSTED_PROXY_HOPS=1
# Swagger/ReDoc (/docs): в docker-compose по умолчанию выключены
# ENABLE_DOCS=true
